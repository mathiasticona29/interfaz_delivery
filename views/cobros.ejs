<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DeliveryFood — Cobros</title>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .badge-pagado    { background:#14532d; color:#4ade80 }
    .badge-pendiente { background:#422006; color:#fb923c }
    .badge-rechazado { background:#450a0a; color:#f87171 }
    .badge-confirmado{ background:#1e3a5f; color:#60a5fa }
    td.actions { white-space:nowrap }
  </style>
</head>
<body>
<nav>
  <a class="nav-brand" href="/">🍔 DeliveryFood</a>
  <div class="nav-links">
    <a href="/">Dashboard</a>
    <a href="/menu">Menú <span class="nav-badge badge-mongo">Mongo</span></a>
    <a href="/carrito">Carrito <span class="nav-badge badge-mongo">Mongo</span></a>
    <a href="/cobros" class="active">Cobros <span class="nav-badge badge-oracle">Oracle</span></a>
    <a href="/restaurantes">Restaurantes <span class="nav-badge badge-oracle">Oracle</span></a>
  </div>
</nav>
<main>
  <div class="header-section">
    <div>
      <div class="page-title">💳 Cobros a Clientes</div>
      <div class="page-subtitle">Tabla <strong>COBROS_CLIENTES</strong> — Oracle XE (usr_financiero) | <%= cobros.length %> registros</div>
    </div>
    <form action="/cobros/simular" method="POST">
      <button type="submit" class="btn-action btn-action-purple">🔷 Simular Registro Relacional</button>
    </form>
  </div>
 
  <div class="card">
    <% if(cobros.length === 0) { %>
      <div class="empty">⚠️ No se pudo conectar a Oracle o no hay datos.<br><small>Verifica que Oracle XE esté corriendo.</small></div>
    <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Usuario</th>
            <th>Monto</th>
            <th>Método</th>
            <th>Estado</th>
            <th>Fecha</th>
            <th>Acción</th>
          </tr>
        </thead>
        <tbody>
          <% cobros.forEach(c => { %>
          <tr>
            <td style="color:#475569"><%= c.ID_COBRO %></td>
            <td>#<%= c.ID_USUARIO %></td>
            <td class="monto">S/ <%= parseFloat(c.MONTO_TOTAL).toFixed(2) %></td>
            <td><span class="metodo"><%= c.METODO_PAGO %></span></td>
            <td><span class="badge badge-<%= (c.ESTADO_PAGO||'').toLowerCase() %>"><%= c.ESTADO_PAGO %></span></td>
            <td style="font-size:.8rem;color:#64748b"><%= c.FECHA_PAGO %></td>
            <td class="actions">
              <% if(c.ESTADO_PAGO === 'PAGADO') { %>
              <form action="/cobros/<%= c.ID_COBRO %>/estado" method="POST" style="display:inline">
                <input type="hidden" name="nuevo_estado" value="CONFIRMADO">
                <button type="submit" class="btn-mini" title="Confirmar cobro">✓ Confirmar</button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</main>
 
<div class="toast" id="toast">✅ Operación ejecutada correctamente</div>
<script>
  if(new URLSearchParams(window.location.search).get('ok')){
    const t = document.getElementById('toast');
    t.style.display = 'flex';
    setTimeout(() => t.style.display = 'none', 3000);
  }
</script>
</body>
</html>
 
 