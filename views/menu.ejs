<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DeliveryFood — Menú</title>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .menu-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(340px,1fr)); gap:1rem }
    .menu-card { background:#1a1d2e; border:1px solid #2d3148; border-radius:12px; padding:1.25rem }
    .menu-card-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1rem; padding-bottom:.75rem; border-bottom:1px solid #2d3148 }
    .rest-name  { font-weight:600; color:#f1f5f9; font-size:.95rem }
    .rest-id    { font-size:.75rem; color:#475569; margin-top:.2rem }
    .rest-count { font-size:.75rem; background:#2d3148; padding:.2rem .5rem; border-radius:6px; color:#94a3b8; white-space:nowrap }
    .categoria  { margin-bottom:.75rem }
    .cat-name   { font-size:.75rem; font-weight:700; color:#f97316; text-transform:uppercase; letter-spacing:.05em; margin-bottom:.4rem }
    .plato      { display:flex; justify-content:space-between; align-items:center; padding:.25rem 0; border-bottom:1px solid #1e2236; font-size:.82rem }
    .plato:last-child { border-bottom:none }
    .plato-nombre { color:#cbd5e1 }
    .plato-nombre.no-disp { color:#475569; text-decoration:line-through }
    .plato-precio { color:#f97316; font-weight:600; white-space:nowrap; margin-left:.5rem }
    .plato-info { display:flex; align-items:center; gap:.4rem }
    .dot        { width:6px; height:6px; border-radius:50% }
    .dot-green  { background:#4ade80 }
    .dot-red    { background:#f87171 }
  </style>
</head>
<body>
<nav>
  <a class="nav-brand" href="/">🍔 DeliveryFood</a>
  <div class="nav-links">
    <a href="/">Dashboard</a>
    <a href="/menu" class="active">Menú <span class="nav-badge badge-mongo">Mongo</span></a>
    <a href="/carrito">Carrito <span class="nav-badge badge-mongo">Mongo</span></a>
    <a href="/cobros">Cobros <span class="nav-badge badge-oracle">Oracle</span></a>
    <a href="/restaurantes">Restaurantes <span class="nav-badge badge-oracle">Oracle</span></a>
  </div>
</nav>
<main>
  <div class="page-title">🍽️ Menús de Restaurantes</div>
  <div class="page-subtitle">Colección <strong>Menu</strong> — MongoDB Delivery_Food | <%= menus.length %> restaurantes</div>
 
  <% if(menus.length === 0) { %>
    <div class="card"><div class="empty">⚠️ No se encontraron menús en MongoDB.<br><small>Verifica que la colección Menu tenga datos.</small></div></div>
  <% } else { %>
  <div class="menu-grid">
    <% menus.forEach(menu => {
      const totalPlatos = (menu.categorias||[]).reduce((acc,c) => acc + (c.items||[]).length, 0);
    %>
    <div class="menu-card">
      <div class="menu-card-header">
        <div>
          <div class="rest-name"><%= menu.nombre_restaurante %></div>
          <div class="rest-id">ID: <%= menu.restaurante_id %></div>
        </div>
        <div class="rest-count"><%= totalPlatos %> platos</div>
      </div>
      <% (menu.categorias||[]).forEach(cat => { %>
        <div class="categoria">
          <div class="cat-name"><%= cat.nombre_categoria %></div>
          <% (cat.items||[]).forEach(plato => { %>
            <div class="plato">
              <div class="plato-info">
                <div class="dot <%= plato.disponible ? 'dot-green' : 'dot-red' %>"></div>
                <span class="plato-nombre <%= !plato.disponible ? 'no-disp' : '' %>"><%= plato.nombre %></span>
              </div>
              <span class="plato-precio">S/ <%= Number(plato.precio).toFixed(2) %></span>
            </div>
          <% }) %>
        </div>
      <% }) %>
    </div>
    <% }) %>
  </div>
  <% } %>
</main>
</body>
</html>